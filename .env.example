MUSIC_PROVIDER="builtin-synth"
STORAGE_DIR="storage"
BLOCKED_TERMS="beatles|the beatles,daft punk|daftpunk"
MUSICGEN_BASE_URL="http://127.0.0.1:8000"
# ElevenLabs Music
ELEVENLABS_API_KEY=""
