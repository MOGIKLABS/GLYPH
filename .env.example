ELEVEN_MUSIC_MODEL_ID="music_v1"
ELEVEN_MUSIC_OUTPUT_FORMAT="mp3_44100_128"
ELEVEN_MUSIC_FORCE_INSTRUMENTAL="false"
# Replicate hosted MusicGen
REPLICATE_API_TOKEN=""
REPLICATE_MUSICGEN_MODEL="meta/musicgen"
